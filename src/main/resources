name: FancyCrystal
version: '${project.version}'
main: de.lmcstudios.fancycrystal.FancyCrystalPlugin
api-version: '1.21'
authors: [LMC Studios]
description: Custom Crystal currency for Vault with a configurable shop
website: https://github.com/LMC-Studios/FancyCrystal
depend: [Vault]

commands:
  crystals:
    description: Zeigt deinen Crystal-Kontostand
    usage: /crystals
  crystalshop:
    description: Öffnet den Crystal-Shop
    usage: /crystalshop
    aliases: [cshop]
  crystalspay:
    description: Sende Crystals an einen Spieler
    usage: /crystalspay <Spieler> <Betrag>
    aliases: [cpay]
  setcrystals:
    description: Setzt den Crystal-Kontostand eines Spielers
    usage: /setcrystals <Spieler> <Betrag>
    permission: fancycrystal.admin
  addcrystals:
    description: Fügt Crystals hinzu
    usage: /addcrystals <Spieler> <Betrag>
    permission: fancycrystal.admin
  removecrystals:
    description: Entfernt Crystals
    usage: /removecrystals <Spieler> <Betrag>
    permission: fancycrystal.admin

permissions:
  fancycrystal.admin:
    description: Admin-Rechte für FancyCrystal-Commands
    default: op
  fancycrystal.use:
    description: Erlaubt Crystal-Commands
    default: true
  fancycrystal.shop:
    description: Erlaubt den Shop-Zugriff
    default: true
